    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="v_id" expression="stg.product_reference == null ? &quot;&quot; : stg.product_reference.trim().toUpperCase()" type="id_String"/>
        <mapperTableEntries name="v_id_ok" expression="Var.v_id.matches(&quot;^PROD[0-9]{3}$&quot;)" type="id_Boolean"/>
        <mapperTableEntries name="v_sale" expression="DQUtils.parseAmount(stg.sale_price)" type="id_BigDecimal"/>
        <mapperTableEntries name="v_sale_ok" expression="Var.v_sale != null &amp;&amp; Var.v_sale.signum() > 0" type="id_Boolean"/>
        <mapperTableEntries name="v_cost" expression="DQUtils.parseAmount(stg.purchase_cost)" type="id_BigDecimal"/>
        <mapperTableEntries name="v_cost_ok" expression="Var.v_cost != null &amp;&amp; Var.v_cost.signum() > 0" type="id_Boolean"/>
        <mapperTableEntries name="v_warn" expression="(DQUtils.clean(stg.category) == null ? &quot;MISSING_CATEGORY;&quot;&#xD;&#xA;   : cat_ref.category_name == null ? &quot;UNKNOWN_CATEGORY;&quot;&#xD;&#xA;   : cat_ref.is_correction ? &quot;CATEGORY_CORRECTED;&quot; : &quot;&quot;)&#xD;&#xA;+ (DQUtils.clean(stg.brand) == null ? &quot;MISSING_BRAND;&quot;&#xD;&#xA;   : brand_ref.brand_name == null ? &quot;UNKNOWN_BRAND;&quot; : &quot;&quot;)&#xD;&#xA;+ (DQUtils.clean(stg.sale_price) == null ? &quot;MISSING_SALE_PRICE;&quot;&#xD;&#xA;   : !Var.v_sale_ok ? &quot;INVALID_SALE_PRICE;&quot; : &quot;&quot;)&#xD;&#xA;+ (DQUtils.clean(stg.purchase_cost) == null ? &quot;MISSING_PURCHASE_COST;&quot;&#xD;&#xA;   : !Var.v_cost_ok ? &quot;INVALID_PURCHASE_COST;&quot; : &quot;&quot;)&#xD;&#xA;+ (Var.v_sale_ok &amp;&amp; Var.v_cost_ok &amp;&amp; Var.v_cost.compareTo(Var.v_sale) >= 0&#xD;&#xA;   ? &quot;COST_ABOVE_PRICE;&quot; : &quot;&quot;) " type="id_String"/>
        <mapperTableEntries name="v_raw" expression="stg.product_reference + &quot;|&quot; + stg.product_name + &quot;|&quot; + stg.brand + &quot;|&quot; + stg.category + &quot;|&quot; + stg.sale_price + &quot;|&quot; + stg.purchase_cost " type="id_String"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="clean" expressionFilter="Var.v_id_ok" activateExpressionFilter="true">
        <mapperTableEntries name="product_id" expression="Var.v_id " type="id_String" nullable="true"/>
        <mapperTableEntries name="product_name" expression="DQUtils.clean(stg.product_name)" type="id_String" nullable="true"/>
        <mapperTableEntries name="brand" expression="brand_ref.brand_name != null ? brand_ref.brand_name : DQUtils.clean(stg.brand)" type="id_String" nullable="true"/>
        <mapperTableEntries name="category" expression="cat_ref.category_name" type="id_String" nullable="true"/>
        <mapperTableEntries name="sale_price" expression="Var.v_sale_ok ? Var.v_sale : null" type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="purchase_cost" expression="Var.v_cost_ok ? Var.v_cost : null" type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="batch_id" expression="stg.batch_id" type="id_String" nullable="true"/>
        <mapperTableEntries name="source_row_num" expression="stg.source_row_num" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="dq_warnings" expression="Var.v_warn" type="id_String" nullable="true"/>
        <mapperTableEntries name="raw_values" expression="Var.v_raw" type="id_String" nullable="true"/>
      </outputTables>
      <outputTables sizeState="INTERMEDIATE" name="rej_id" expressionFilter="!Var.v_id_ok&#xD;&#xA;" activateExpressionFilter="true">
        <mapperTableEntries name="batch_id" expression="stg.batch_id " type="id_String"/>
        <mapperTableEntries name="job_name" expression="&quot;J_03_CleanProducts&quot;" type="id_String"/>
        <mapperTableEntries name="source_table" expression="&quot;products_raw&quot;" type="id_String"/>
        <mapperTableEntries name="source_row_num" expression="stg.source_row_num " type="id_Integer" nullable="true"/>
        <mapperTableEntries name="business_key" expression="stg.product_reference" type="id_String" nullable="true"/>
        <mapperTableEntries name="severity" expression="&quot;REJECT&quot;" type="id_String"/>
        <mapperTableEntries name="rule_code" expression="Var.v_id.isEmpty() ? &quot;MISSING_PRODUCT_REFERENCE&quot; : &quot;INVALID_PRODUCT_REFERENCE&quot;" type="id_String"/>
        <mapperTableEntries name="raw_values" expression="Var.v_raw " type="id_String" nullable="true"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="stg" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="batch_id" type="id_String"/>
        <mapperTableEntries name="source_row_num" type="id_Integer"/>
        <mapperTableEntries name="product_reference" type="id_String" nullable="true"/>
        <mapperTableEntries name="product_name" type="id_String" nullable="true"/>
        <mapperTableEntries name="brand" type="id_String" nullable="true"/>
        <mapperTableEntries name="category" type="id_String" nullable="true"/>
        <mapperTableEntries name="sale_price" type="id_String" nullable="true"/>
        <mapperTableEntries name="purchase_cost" type="id_String" nullable="true"/>
        <mapperTableEntries name="loaded_at" type="id_Date"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="brand_ref" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="alias_key" expression="stg.brand == null ? &quot;&quot; : stg.brand.trim().toLowerCase()" type="id_String"/>
        <mapperTableEntries name="brand_name" expression="" type="id_String"/>
      </inputTables>
      <inputTables sizeState="INTERMEDIATE" name="cat_ref" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="alias_key" expression="stg.category == null ? &quot;&quot; : stg.category.trim().toLowerCase()" type="id_String"/>
        <mapperTableEntries name="category_name" type="id_String"/>
        <mapperTableEntries name="is_correction" type="id_Boolean"/>
      </inputTables>
    </nodeData>
  </node>
