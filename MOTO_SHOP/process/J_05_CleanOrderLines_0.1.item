    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="v_id" expression="stg.line_id == null ? &quot;&quot; : stg.line_id.trim().toUpperCase()" type="id_String"/>
        <mapperTableEntries name="v_id_ok" expression="Var.v_id.matches(&quot;^LINE[0-9]{6}$&quot;)" type="id_Boolean"/>
        <mapperTableEntries name="v_order" expression="stg.order_id == null ? &quot;&quot; : stg.order_id.trim().toUpperCase()" type="id_String"/>
        <mapperTableEntries name="v_product" expression="stg.product_id == null ? &quot;&quot; : stg.product_id.trim().toUpperCase()" type="id_String"/>
        <mapperTableEntries name="v_qty" expression="DQUtils.parseInteger(stg.quantity)" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="v_price_raw" expression="DQUtils.parseAmount(stg.unit_price_charged)" type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="v_ratio" expression="Var.v_price_raw != null &amp;&amp; prod_ref.sale_price != null&#xD;&#xA;  ? Var.v_price_raw.divide(prod_ref.sale_price, 4, java.math.RoundingMode.HALF_UP)&#xD;&#xA;  : null" type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="v_scale_fix" expression="Var.v_ratio != null&#xD;&#xA;  &amp;&amp; Var.v_ratio.compareTo(new java.math.BigDecimal(&quot;95&quot;)) >= 0&#xD;&#xA;  &amp;&amp; Var.v_ratio.compareTo(new java.math.BigDecimal(&quot;105&quot;)) &lt;= 0" type="id_Boolean"/>
        <mapperTableEntries name="v_price" expression="Var.v_scale_fix&#xD;&#xA;  ? Var.v_price_raw.divide(new java.math.BigDecimal(&quot;100&quot;), 2, java.math.RoundingMode.HALF_UP)&#xD;&#xA;  : Var.v_price_raw" type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="v_reject" expression="(!Var.v_id_ok ? (Var.v_id.isEmpty() ? &quot;MISSING_LINE_ID;&quot; : &quot;INVALID_LINE_ID;&quot;) : &quot;&quot;)&#xD;&#xA;+ (Var.v_order.isEmpty() ? &quot;MISSING_ORDER_ID;&quot;&#xD;&#xA;   : order_ref.order_id == null ? &quot;ORDER_NOT_FOUND;&quot; : &quot;&quot;)&#xD;&#xA;+ (Var.v_product.isEmpty() ? &quot;MISSING_PRODUCT_ID;&quot;&#xD;&#xA;   : prod_ref.product_id == null ? &quot;UNKNOWN_PRODUCT_ID;&quot; : &quot;&quot;)&#xD;&#xA;+ (DQUtils.clean(stg.quantity) == null ? &quot;MISSING_QUANTITY;&quot;&#xD;&#xA;   : Var.v_qty == null || Var.v_qty &lt;= 0 ? &quot;INVALID_QUANTITY;&quot; : &quot;&quot;)&#xD;&#xA;+ (DQUtils.clean(stg.unit_price_charged) == null ? &quot;MISSING_UNIT_PRICE;&quot;&#xD;&#xA;   : Var.v_price_raw == null || Var.v_price_raw.signum() &lt;= 0 ? &quot;INVALID_UNIT_PRICE;&quot; : &quot;&quot;) " type="id_String"/>
        <mapperTableEntries name="v_warn" expression="(Var.v_qty != null &amp;&amp; Var.v_qty > 10 ? &quot;ABNORMAL_QUANTITY;&quot; : &quot;&quot;)&#xD;&#xA;+ (Var.v_scale_fix ? &quot;PRICE_SCALE_CORRECTED;&quot; : &quot;&quot;)&#xD;&#xA;+ (Var.v_ratio != null &amp;&amp; !Var.v_scale_fix &amp;&amp; Var.v_price_raw.signum() > 0&#xD;&#xA;   &amp;&amp; (Var.v_ratio.compareTo(new java.math.BigDecimal(&quot;1.5&quot;)) > 0&#xD;&#xA;       || Var.v_ratio.compareTo(new java.math.BigDecimal(&quot;0.3&quot;)) &lt; 0)&#xD;&#xA;   ? &quot;PRICE_OUTLIER;&quot; : &quot;&quot;) " type="id_String"/>
        <mapperTableEntries name="v_raw" expression="stg.line_id + &quot;|&quot; + stg.order_id + &quot;|&quot; + stg.product_id + &quot;|&quot; + stg.quantity + &quot;|&quot; + stg.unit_price_charged" type="id_String"/>
      </varTables>
