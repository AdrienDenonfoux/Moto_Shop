      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="v_id" expression="stg.customer_id == null ? &quot;&quot; : stg.customer_id.trim().toUpperCase()" type="id_String"/>
        <mapperTableEntries name="v_id_ok" expression="Var.v_id.matches(&quot;^CUST[0-9]{4}$&quot;)" type="id_Boolean"/>
        <mapperTableEntries name="v_email" expression="DQUtils.clean(stg.email) == null ? null : stg.email.trim().toLowerCase()" type="id_String"/>
        <mapperTableEntries name="v_signup" expression="DQUtils.parseDate(stg.registration_date)" type="id_Date"/>
        <mapperTableEntries name="v_signup_ok" expression="Var.v_signup != null &amp;&amp; !Var.v_signup.after(TalendDate.getCurrentDate())" type="id_Boolean"/>
        <mapperTableEntries name="v_warn" expression="(DQUtils.clean(stg.city) == null ? &quot;MISSING_CITY;&quot;&#xD;&#xA;   : city_ref.city_name == null ? &quot;UNKNOWN_CITY;&quot;&#xD;&#xA;   : city_ref.is_correction ? &quot;CITY_CORRECTED;&quot; : &quot;&quot;)&#xD;&#xA;+ (Var.v_email == null ? &quot;MISSING_EMAIL;&quot;&#xD;&#xA;   : !DQUtils.isValidEmail(Var.v_email) ? &quot;INVALID_EMAIL;&quot; : &quot;&quot;)&#xD;&#xA;+ (DQUtils.clean(stg.registration_date) == null ? &quot;MISSING_SIGNUP_DATE;&quot;&#xD;&#xA;   : Var.v_signup == null ? &quot;INVALID_SIGNUP_DATE;&quot;&#xD;&#xA;   : !Var.v_signup_ok ? &quot;FUTURE_SIGNUP_DATE;&quot; : &quot;&quot;) " type="id_String"/>
        <mapperTableEntries name="v_raw" expression="stg.customer_id + &quot;|&quot; + stg.first_name + &quot;|&quot; + stg.last_name + &quot;|&quot; + stg.city + &quot;|&quot; + stg.email + &quot;|&quot; + stg.registration_date" type="id_String"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="clean" expressionFilter="Var.v_id_ok" activateExpressionFilter="true" columnNameFilter="">
        <mapperTableEntries name="customer_id" expression="Var.v_id " type="id_String" nullable="true"/>
        <mapperTableEntries name="first_name" expression="DQUtils.capitalize(stg.first_name)" type="id_String" nullable="true"/>
        <mapperTableEntries name="last_name" expression="DQUtils.capitalize(stg.last_name)" type="id_String" nullable="true"/>
        <mapperTableEntries name="city" expression="city_ref.city_name " type="id_String" nullable="true"/>
        <mapperTableEntries name="email" expression="DQUtils.isValidEmail(Var.v_email) ? Var.v_email : null" type="id_String" nullable="true"/>
        <mapperTableEntries name="signup_date" expression="Var.v_signup_ok ? Var.v_signup : null" type="id_Date" nullable="true"/>
        <mapperTableEntries name="batch_id" expression="stg.batch_id" type="id_String" nullable="true"/>
        <mapperTableEntries name="source_row_num" expression="stg.source_row_num" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="dq_warnings" expression="Var.v_warn " type="id_String" nullable="true"/>
        <mapperTableEntries name="raw_values" expression="Var.v_raw " type="id_String" nullable="true"/>
      </outputTables>
      <outputTables sizeState="INTERMEDIATE" name="rej_id" expressionFilter="!Var.v_id_ok" activateExpressionFilter="true">
        <mapperTableEntries name="batch_id" expression="stg.batch_id" type="id_String"/>
        <mapperTableEntries name="job_name" expression="&quot;J_02_CleanCustomers&quot;" type="id_String"/>
        <mapperTableEntries name="source_table" expression="&quot;customers_raw&quot;" type="id_String"/>
        <mapperTableEntries name="source_row_num" expression="stg.source_row_num" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="business_key" expression="stg.customer_id" type="id_String" nullable="true"/>
        <mapperTableEntries name="severity" expression="&quot;REJECT&quot;" type="id_String"/>
        <mapperTableEntries name="rule_code" expression="Var.v_id.isEmpty() ? &quot;MISSING_CUSTOMER_ID&quot; : &quot;INVALID_CUSTOMER_ID&quot;" type="id_String"/>
        <mapperTableEntries name="raw_values" expression="Var.v_raw" type="id_String" nullable="true"/>
      </outputTables>
